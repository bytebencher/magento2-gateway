{
    "name": "bytebencher/magento2-gateway",
    "description": "Reusable Magento 2 gateway foundation for REST and SOAP integrations.",
    "type": "magento2-module",
    "homepage": "https://github.com/bytebencher/magento2-gateway",
    "prefer-stable": true,
    "license": [
        "proprietary"
    ],
    "keywords": [
        "magento2",
        "magento",
        "gateway",
        "rest",
        "soap",
        "integration"
    ],
    "require": {
        "php": "~7.4|~8.1",
        "ext-json": "*",
        "ext-soap": "*",
        "thecodingmachine/safe": "^1.3.3 || ^2.0",
        "laminas/laminas-http": "~2.6",
        "magento/framework": "~103.0"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "ByteBencher\\Gateway\\": ""
        }
    },
    "support": {
        "docs": "https://github.com/bytebencher/magento2-gateway#readme",
        "issues": "https://github.com/bytebencher/magento2-gateway/issues",
        "source": "https://github.com/bytebencher/magento2-gateway"
    },
    "authors": [
        {
            "name": "ByteBencher",
            "homepage": "https://github.com/bytebencher",
            "role": "Maintainer"
        }
    ]
}
